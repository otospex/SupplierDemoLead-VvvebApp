# Default-deny — only paths explicitly un-ignored below are sent to the Docker build context.
# Keeps the build small and prevents accidentally shipping local artifacts (storage, node_modules, .git, etc.).
*

# Files needed by Dockerfile / Dockerfile.dokploy:
!php.ini
!init.dokploy.sh
!seed.dokploy.php
!seed.dokploy.sql

# Site config (per-language homepage template) — overlaid so /fr/ uses index.fr.html.
!config
config/*
!config/sites.php
!config/plugins.php
!config/app-routes.php
!env.php
!nginx.dokploy.conf

# Canonical host, sitemaps, robots, legacy /page/ redirects.
!system
system/*
!system/functions.php
!system/sitemap-builder.php

# Content controller carrying the language-suffixed-template fallback that
# localizes sub-page / post chrome (content/<name>.<lang>.html).
!app
app/*
!app/controller
app/controller/*
!app/controller/base.php
!app/controller/index.php
!app/controller/sitemap.php
!app/controller/content
app/controller/content/*
!app/controller/content/index.php
!app/controller/content/post.php
!app/controller/content/legacy-page.php
!app/controller/feed
app/controller/feed/*
!app/controller/feed/robots.php
!app/component
app/component/*
!app/component/language.php
!app/template
app/template/*
!app/template/common.tpl
!app/template/content
app/template/content/*
!app/template/content/post.tpl

# Frontend post-status guards copied by Dockerfile.dokploy.
!app/sql
app/sql/*
!app/sql/mysqli
app/sql/mysqli/*
!app/sql/mysqli/post.sql
!app/sql/pgsql
app/sql/pgsql/*
!app/sql/pgsql/post.sql
!app/sql/sqlite
app/sql/sqlite/*
!app/sql/sqlite/post.sql

# Operational and editorial CLIs, copied outside the public document root.
!scripts
!scripts/**
# Kept explicit as well: scripts/tests/scheduled-publisher-test.php pins them.
!scripts/lib/scheduled-publisher.php
!scripts/lib/cache-invalidator.php
!scripts/publish-scheduled-content.php
!scripts/approve-scheduled-content.php
!scripts/migrate-lead-schema.php

# Custom plugin sources + browser-served assets (Dockerfile.dokploy COPYs these).
!plugins
!plugins/lead-platform-connector
!plugins/lead-platform-connector/**
!plugins/solutions-directory
!plugins/solutions-directory/**
!public
!public/plugins
!public/plugins/lead-platform-connector
!public/plugins/lead-platform-connector/**
!public/plugins/solutions-directory
!public/plugins/solutions-directory/**
!public/vrobots.txt
!public/media
public/media/*
!public/media/editorial
!public/media/editorial/**
!public/media/independant-digital-logo.png

# Theme overrides.
!public/themes
!public/themes/landing
!public/themes/landing/**
!public/themes/souverainete-digitale
!public/themes/souverainete-digitale/**

# Re-ignore noisy subdirs that may live inside the un-ignored paths.
**/.git
**/.DS_Store
**/node_modules
**/storage/cache/*
**/storage/compiled-templates/*
