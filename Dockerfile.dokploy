# Production image for Dokploy deploys.
#
# The upstream vvveb/vvvebcms image downloads the Vvveb application from
# www.vvveb.com at first container start (via /init.sh) into /var/www/html,
# but ONLY if /var/www/html/public/ doesn't already exist. So we cannot COPY
# our files directly into /var/www/html at build time — that would short-circuit
# init.sh and leave the app missing.
#
# Strategy: stash our overlays at /opt/lpc-overlay/ during build, then replace
# the upstream init.sh with a version that runs upstream bootstrap first, copies
# our overlays on top, and then starts supervisord (php-fpm + nginx).

FROM vvveb/vvvebcms@sha256:ba2fff03f58b5914c81c9eb9924e1ab8e095f788244c2d4fb563c288ff096b8a

# The production stack uses MySQL. The upstream runtime ships mysqli for the
# CMS but not the PDO driver required by the scheduler and approval CLIs.
RUN docker-php-ext-install pdo_mysql

# 1. Stage our overlays in a neutral path that upstream init.sh's existence check ignores.
COPY plugins/lead-platform-connector \
     /opt/lpc-overlay/plugins/lead-platform-connector

COPY public/plugins/lead-platform-connector \
     /opt/lpc-overlay/public/plugins/lead-platform-connector

COPY public/themes/landing \
     /opt/lpc-overlay/public/themes/landing

COPY public/themes/souverainete-digitale \
     /opt/lpc-overlay/public/themes/souverainete-digitale

# 1a. Site config (per-language homepage template: index.html / index.fr.html)
#     and the content controller carrying the language-suffixed-template fallback
#     used to localize sub-page/post chrome (content/<name>.<lang>.html). These
#     live in the webroot overlay so they re-apply on every redeploy; without
#     them the persistent volume keeps stale copies and /fr/ serves English.
COPY config/sites.php \
     /opt/lpc-overlay/config/sites.php

# Keep the connector active after the upstream bootstrap or a volume-backed
# redeploy. The seed creates its storage; this configuration enables its
# runtime hooks and administration screens.
COPY config/plugins.php \
     /opt/lpc-overlay/config/plugins.php

COPY app/controller/index.php \
     /opt/lpc-overlay/app/controller/index.php

COPY app/controller/base.php \
     /opt/lpc-overlay/app/controller/base.php

COPY app/controller/content/index.php \
     /opt/lpc-overlay/app/controller/content/index.php

COPY app/controller/content/post.php \
     /opt/lpc-overlay/app/controller/content/post.php

# Frontend route guards for scheduled/draft posts.
COPY app/sql/mysqli/post.sql \
     /opt/lpc-overlay/app/sql/mysqli/post.sql
COPY app/sql/pgsql/post.sql \
     /opt/lpc-overlay/app/sql/pgsql/post.sql
COPY app/sql/sqlite/post.sql \
     /opt/lpc-overlay/app/sql/sqlite/post.sql

# Editorially gated scheduled publisher. These scripts live outside public/.
COPY scripts/lib/scheduled-publisher.php \
     /opt/lpc-overlay/scripts/lib/scheduled-publisher.php
COPY scripts/lib/cache-invalidator.php \
     /opt/lpc-overlay/scripts/lib/cache-invalidator.php
COPY scripts/publish-scheduled-content.php \
     /opt/lpc-overlay/scripts/publish-scheduled-content.php
COPY scripts/approve-scheduled-content.php \
     /opt/lpc-overlay/scripts/approve-scheduled-content.php
COPY scripts/migrate-lead-schema.php \
     /opt/lpc-overlay/scripts/migrate-lead-schema.php

# 1b. One-time DB seed scripts. Staged OUTSIDE /opt/lpc-overlay so the
#     `cp -a /opt/lpc-overlay/.` webroot overlay does NOT copy them into the
#     public tree (keeps seed.dokploy.sql from ever being web-served).
COPY seed.dokploy.php /opt/seed/seed.dokploy.php
COPY seed.dokploy.sql /opt/seed/seed.dokploy.sql

# 2. Custom PHP config (outside /var/www/html — applied at build time).
COPY php.ini /usr/local/etc/php/php.ini

# 3. Replace init.sh:
#    - keep upstream bootstrap logic (curl + unzip Vvveb on first run)
#    - copy our overlay AFTER bootstrap, EVERY run (so plugin updates land on redeploy)
#    - start supervisord at the end (same as upstream)
COPY init.dokploy.sh /init.sh
RUN chmod +x /init.sh
